# Клавиатуры и мыши IO Red Square — доступ программе iohub-desktop.
#
# Без этого правила /dev/hidraw* принадлежит root с правами 0600, и программа не
# может открыть устройство от имени обычного пользователя: клавиатура в списке
# видна, но настройка клавиш не работает.
#
# TAG+="uaccess" выдаёт доступ той учётной записи, которая сейчас сидит за этим
# компьютером, — добавлять никого в группы не нужно. Номера вендоров здесь совпадают
# со списком, который разрешает сама программа (webhid-shim.js, ALLOWED_VENDORS).
#
#   05ac  клавиатуры IO (IO Type 68 Pro и другие модели линейки)
#   0c45  часть ранних клавиатур IO
#   3554  мыши Red Square

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", TAG+="uaccess"

# Если uaccess не работает (система без systemd-logind, старый udev), тем же трём
# строкам можно вместо TAG+="uaccess" добавить MODE="0666" — это откроет устройства
# всем подряд, поэтому оставляйте этот вариант только если первый отказал.
